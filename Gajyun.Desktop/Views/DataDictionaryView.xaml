<UserControl x:Class="Gajyun.Desktop.Views.DataDictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Data Dictionary" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SchemaVersion}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#245D49" />
            <TextBlock Text="{Binding Status}" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="#52606D" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="Search table or field name" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dictionary search" Padding="8,5" />
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedTable.Name}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTable.Purpose}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding SelectedTable.Version, StringFormat=Introduced in version: {0} (implemented)}" Margin="0,5,0,0" Foreground="#52606D" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="SQL type" Binding="{Binding SqlType}" Width="120" />
                        <DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired}" />
                        <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" />
                        <DataGridTextColumn Header="FK reference" Binding="{Binding ForeignKey}" Width="190" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="350" />
                        <DataGridTextColumn Header="Default / computed" Binding="{Binding DefaultValue}" Width="200" />
                        <DataGridTextColumn Header="Example" Binding="{Binding Example}" Width="140" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Padding="10" Margin="0,12,0,8" Background="#EFF5F1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedField.Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedField.Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedField.DefaultValue, StringFormat=Default / expression: {0}}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedField.Example, StringFormat=Example: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TabControl Grid.Row="3">
                    <TabItem Header="Relationships"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedTable.Relationships}" TextWrapping="Wrap" Margin="10" /></ScrollViewer></TabItem>
                    <TabItem Header="Keys and constraints"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedTable.Constraints}" TextWrapping="Wrap" Margin="10" /></ScrollViewer></TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
