<UserControl x:Class="Gajyun.Desktop.Views.CsvImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="BookingList">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DataGrid x:Name="Bookings" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Booking" Binding="{Binding Row.ReservationNumber}" Width="155" />
                        <DataGridTextColumn Header="OTA" Binding="{Binding Row.OTAName}" Width="100" />
                        <DataGridTextColumn Header="Guest" Binding="{Binding Row.GuestName}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Arrival" Binding="{Binding Row.CheckIn, StringFormat=yyyy-MM-dd}" Width="105" />
                        <DataGridTextColumn Header="Departure" Binding="{Binding Row.CheckOut, StringFormat=yyyy-MM-dd}" Width="105" />
                        <DataGridTextColumn Header="Room" Binding="{Binding Row.RoomName}" Width="110" />
                        <DataGridTextColumn Header="JPY" Binding="{Binding Row.AccommodationTotal, StringFormat=N0}" Width="85" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding SelectedItem.Row.Message, ElementName=Bookings}" TextWrapping="Wrap" Margin="8" Foreground="#52606D" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Import bookings" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="1. Choose a file   2. Review changes and questions   3. Approve and import" Foreground="#52606D" Margin="0,6,0,16" />
            <DockPanel>
                <Button Content="Choose CSV" Command="{Binding SelectFileCommand}" Padding="18,8" Margin="0,0,12,0" DockPanel.Dock="Left" />
                <Button Content="Review again" Command="{Binding ValidateFileCommand}" Padding="12,8" Margin="0,0,12,0" DockPanel.Dock="Left" />
                <Button Content="Cancel" Command="{Binding CancelWorkCommand}" IsEnabled="{Binding IsLoading}" Padding="12,8" DockPanel.Dock="Right" />
                <TextBlock Text="{Binding SelectedFile}" ToolTip="{Binding SelectedPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,14,0,12">
            <ProgressBar Height="4" IsIndeterminate="{Binding IsLoading}" />
            <TextBlock Text="{Binding ImportSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Status}" Foreground="#52606D" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabControl.Style><Style TargetType="TabControl"><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></TabControl.Style>
            <TabItem Header="New bookings"><ContentControl Content="{Binding NewBookings}" ContentTemplate="{StaticResource BookingList}" /></TabItem>
            <TabItem Header="Changed"><ContentControl Content="{Binding ChangedBookings}" ContentTemplate="{StaticResource BookingList}" /></TabItem>
            <TabItem Header="Was active → cancelled"><ContentControl Content="{Binding CancelledBookings}" ContentTemplate="{StaticResource BookingList}" /></TabItem>
            <TabItem Header="Questions / held">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Same name does not mean the same person. Choose a customer, or select Different person. Resolve room conflicts or leave them held." TextWrapping="Wrap" Margin="10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Questions}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Booking / guest" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Row.ReservationNumber}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Row.GuestName}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Row.OTAName}" Foreground="#52606D" FontSize="11" />
                                    <TextBlock Text="{Binding Row.CheckIn, StringFormat=Arrival: {0:yyyy-MM-dd}}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Row.Message}" IsReadOnly="True" Width="*" MinWidth="150">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Is this the same customer?" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding CustomerMatches}" SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" IsEnabled="{Binding HasCustomerQuestion}" ToolTip="Choose explicitly; names alone never merge customers." />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Correct room" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding RoomChoices}" SelectedItem="{Binding SelectedRoom, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="RoomName" IsEnabled="{Binding HasRoomQuestion}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <Expander Grid.Row="3" Header="Advanced: encoding and original CSV" Margin="0,12,0,0">
            <Expander.Style><Style TargetType="Expander"><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Expander.Style>
            <StackPanel>
                <WrapPanel Margin="0,8,0,8">
                    <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" DisplayMemberPath="Label" MinWidth="260" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Delimiters}" SelectedItem="{Binding SelectedDelimiter}" DisplayMemberPath="Label" Width="110" Margin="0,0,12,0" />
                    <Button Content="Reload preview" Command="{Binding ReloadCommand}" Padding="10,4" />
                </WrapPanel>
                <TextBlock Text="{Binding EncodingInformation}" Foreground="#52606D" />
                <DataGrid ItemsSource="{Binding Preview}" IsReadOnly="True" AutoGenerateColumns="True" AutoGeneratingColumn="PreviewAutoGeneratingColumn" CanUserAddRows="False" MaxHeight="140" />
                <TextBlock Text="{Binding ImportExplanation}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#875500" />
            </StackPanel>
        </Expander>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox Content="Approve shown changes, cancellations and customer/room choices. Unresolved held rows are excluded."
                      IsChecked="{Binding ReviewAcknowledged}" Margin="0,0,0,10">
                <CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style>
            </CheckBox>
            <Button Content="Import approved batch" Command="{Binding ImportCommand}" HorizontalAlignment="Left" Padding="20,9" />
            <TextBlock Text="{Binding ImportResults}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</UserControl>
