    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gajyun.Core\Gajyun.Core.csproj" />
